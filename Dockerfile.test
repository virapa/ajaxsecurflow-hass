# Test image: Home Assistant test harness on Linux (Windows lacks wheels for some HA deps).
# gcc is needed because lru-dict (an HA dependency) ships no cp313 wheel and is built from source.
FROM python:3.13-slim
WORKDIR /app
COPY requirements_test.txt .
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && pip install --no-cache-dir -r requirements_test.txt \
    && apt-get purge -y --auto-remove build-essential \
    && rm -rf /var/lib/apt/lists/*
CMD ["python", "-m", "pytest", "tests", "-q"]
